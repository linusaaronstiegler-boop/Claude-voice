<?xml version="1.0" encoding="utf-8"?>
<!-- Nichts aus dieser App wandert in ein Cloud-Backup oder beim Handywechsel aufs neue Gerät:
     weder die Schlüssel noch das Gedächtnis (Notizen, Kopien verknüpfter Dateien). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
